# Copy to .env and fill in. Never commit .env.
# At least 32 random characters, for example: openssl rand -hex 32
PROXY_KEY=
# From Cloudflare Zero Trust > Networks > Tunnels (the token of the tunnel you created)
TUNNEL_TOKEN=
# Requests per minute sent to the registry (cache hits are free)
RATE_PER_MIN=20
# Optional: how the proxy introduces itself to the registry
USER_AGENT=whois-demo-proxy/1.0 (+https://whois.piotrmajkutewicz.pl)
