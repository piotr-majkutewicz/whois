{
  "name": "whois",
  "version": "1.0.0",
  "description": "Plain-language domain check for small businesses: registration (RDAP), DNS and e-mail setup. Cloudflare Workers + TypeScript.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "Piotr Majkutewicz",
  "scripts": {
    "dev": "wrangler dev",
    "test": "vitest run",
    "test:e2e": "node test/e2e/ui.e2e.mjs http://127.0.0.1:8970",
    "typecheck": "tsc --noEmit",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261107.1",
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "wrangler": "^4.158.0"
  }
}
